# Copy to .env.development.local (or .env.local) and fill in.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:5051/api
VITE_BACKEND_URL=http://localhost:5051

# Google Identity Services sign-in — leave blank to disable; the button
# renders as a disabled "coming soon" state until this is set.
# Must be the SAME Client ID as the backend's GOOGLE_CLIENT_ID (see
# VenureBackend/.env.example for how to create one). This is the public
# Client ID, not a secret — safe to ship to the browser.
VITE_GOOGLE_CLIENT_ID=
